# ============================================
# Backend Environment Variables
# ============================================
# انسخ هذا الملف إلى .env للاستخدام المحلي:
# cp .env.example .env
#
# ⚠️ لا ترفع .env أبداً على GitHub!

# ============================================
# Server Configuration
# ============================================
# Server Port (Railway يعطيه تلقائياً في الإنتاج)
PORT=5000

# Environment: development | production
NODE_ENV=development

# ============================================
# Database (MongoDB Atlas)
# ============================================
# احصل عليه من: cloud.mongodb.com
# الصيغة: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/blazepoint?retryWrites=true&w=majority

# ============================================
# JWT Authentication
# ============================================
# ⚠️ غيّر هذا المفتاح في الإنتاج!
# استخدم: openssl rand -base64 32
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRE=7d

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
# في التطوير: http://localhost:5173
# في الإنتاج: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# ============================================
# Optional (للمستقبل)
# ============================================
# SENTRY_DSN=
# REDIS_URL=
# CLOUDINARY_URL=